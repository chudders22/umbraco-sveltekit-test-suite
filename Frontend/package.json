{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& vite dev",
		"build": "npm run build:preview-css && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:storybook": "vitest --project=storybook",
		"test:storybook:ui": "vitest --project=storybook --ui",
		"generate-types": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& openapi-typescript https://localhost:44356/umbraco/swagger/delivery/swagger.json -o ./src/lib/types/umbraco.d.ts",
		"build:preview-css": "tailwindcss -i ./src/lib/styles/blockpreview.css -o ../Application.Cms/wwwroot/App_Plugins/global/global.css --minify",
		"watch:preview-css": "tailwindcss -i ./src/lib/styles/blockpreview.css -o ../Application.Cms/wwwroot/App_Plugins/global/global.css --watch"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@storybook/addon-a11y": "^10.2.12",
		"@storybook/addon-docs": "^10.2.12",
		"@storybook/addon-svelte-csf": "^5.0.11",
		"@storybook/addon-vitest": "^10.2.12",
		"@storybook/sveltekit": "^10.2.12",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.2.12",
		"storybook-addon-vis": "^3.1.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}

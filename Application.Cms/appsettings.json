{
  "$schema": "appsettings-schema.json",
  "Cors": {
    "AllowedOrigins": ["https://your-frontend-url.com"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "Automate":{
      "UseNamedConnectionString": "umbracoDbDSN"
    },
    "CMS": {
      "Global": {
        "Id": "cd0c6f1e-3403-44f3-a4a9-62e62dd93eee",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "password12345"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsDirectory": "~/../Application.Models/Generated",
        "AcceptUnsafeModelsDirectory": true,
        "ModelsNamespace": "Application.Models.Generated"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportOnFirstBoot": true
    },
    "Sets": {
      "Default": {
        "HandlerDefaults": {
          "UseFlatStructure": false
        }
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}
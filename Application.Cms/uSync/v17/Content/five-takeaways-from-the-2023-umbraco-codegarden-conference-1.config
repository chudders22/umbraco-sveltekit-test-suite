<?xml version="1.0" encoding="utf-8"?>
<Content Key="3be1e6e8-d8d4-4016-bb66-e58c6b19f850" Alias="Five takeaways from the 2023 Umbraco Codegarden conference (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/FiveTakeawaysFromThe2023UmbracoCodegardenConference1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

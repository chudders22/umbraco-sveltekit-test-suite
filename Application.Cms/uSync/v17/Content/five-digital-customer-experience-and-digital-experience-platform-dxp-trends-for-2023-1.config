<?xml version="1.0" encoding="utf-8"?>
<Content Key="47824182-c203-4a81-a620-d9b6802f6803" Alias="Five digital customer experience and Digital Experience Platform (DXP) trends for 2023 (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/FiveDigitalCustomerExperienceAndDigitalExperiencePlatformDXPTrendsFor20231</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="7e1923f7-5b9d-4aae-8d4e-a387529917f2" Alias="Umbraco HQ announces acquisition of uMarketingSuite (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/UmbracoHQAnnouncesAcquisitionOfUMarketingSuite1</Path>

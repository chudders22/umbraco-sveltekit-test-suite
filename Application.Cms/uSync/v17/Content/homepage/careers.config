      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "1697c20b-8335-4825-a935-19907361e757",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EAt 3chillies, people are at the heart of everything we do.\u003C/h2\u003E\u003Cp\u003EWe love to push what\u0027s possible with technology, but that ultimately only comes from great teamwork.\u003C/p\u003E\u003Cp\u003EWe are committed to inclusivity, collaboration and transparency. We pride ourselves on creating a friendly and supportive work environment that nurtures creativity and innovation, built on mutual trust and values.\u003C/p\u003E\u003Cp\u003EAs trusted advisors to our clients, we take on challenges head on and strive to deliver exceptional results. We are always on the lookout for talented individuals who not only have the right technical skills, but are also passionate, dedicated, and eager to solve problems and overcome obstacles.\u003C/p\u003E\u003Cp\u003EWe offer a competitive salary and benefits, a workplace pension, hybrid work (if preferred) and the opportunity to work with some amazing clients.\u003C/p\u003E\u003Cp\u003EIf you are excited about the prospect of joining a team that values hard work, innovative thinking and collaborating together, we would love to hear from you.\u003C/p\u003E\u003Cp\u003EYou can either view our open positions below or send us your CV with your covering letter to \u003Ca href=\u0022mailto:jointheteam@3chillies.co.uk\u0022\u003Ejointheteam@3chillies.co.uk\u003C/a\u003E.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "59ef225a-9fed-437f-9868-1fe52a9d7671",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EThe CMS or DXP that\u0027s right for you\u003C/h2\u003E\u003Cp\u003EGetting the right DXP or CMS in place is essential to deliver the right experience for your customers. At 3chillies we help to implement the CMS and DXP that your digital marketing team and publishers will love.\u003C/p\u003E\u003Cp\u003EWe\u0027ve helped implement, upgrade and improve hundreds of CMS and DXPs over the years. We currently work with Umbraco, Sitecore, Optimizely and SharePoint / Microsoft 365.\u003C/p\u003E\u003Ch2\u003EWhy we love working with CMSs and DXPs\u003C/h2\u003E\u003Cp\u003EYou might be completely re-platforming, upgrading to the latest version, unlocking new features or looking to rebuild a CMS that you\u0027ve fallen out of love with.\u003C/p\u003E\u003Cp\u003EWe approach each CMS or DXP project with a view of what you\u0027re trying to achieve on the front end, but also how you\u0027re going to use it in the back end. We\u0027ll undertake an initial audit of your existing platform and deliver recommendations.\u003C/p\u003E\u003Cp\u003EAfter your users have been trained and once the new CMS and DXP have been thoroughly tested, we\u0027ll finally launch. We can then commence support or a programme of iterative improvement if desired.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

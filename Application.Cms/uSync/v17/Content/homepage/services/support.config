    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "704782fc-9aa3-456f-9e14-588fddeb259c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003ESupporting you now and in the future.\u003C/h2\u003E\u003Cp\u003EYour website, applications and systems are mission-critical. Our ongoing support services are designed to ensure everything continues to work smoothly across your digital ecosystem, with minimum outages and issues.  \u003C/p\u003E\u003Cp\u003EWe work to achieve the best possible performance, resolving any emerging issues as quickly as possible, and preventing future issues from happening through our proactive approach. \u003C/p\u003E\u003Ch2\u003EWhy our support packages are different\u003C/h2\u003E\u003Cp\u003ESupport is as important as project work. We do everything properly, all underpinned by our robust ticketing system, friendly communication and can-do attitude.\u003C/p\u003E\u003Cp\u003EOur contracts and service level agreements provide clarity with agreed response times for P1, P2 and P3 issues. And all our project development work comes with a warranty with support wrapped in.\u003C/p\u003E\u003Cp\u003EBecause we know one size doesn\u2019t fit all we can also flex our support packages to meet your needs. For example, while most clients are happy with office hours support, we can also provide round-the-clock packages too.\u003C/p\u003E\u003Cp\u003EOverall, we\u2019re very proud of our support packages. We\u2019ve listened carefully to our clients and evolved our offering so that every support contract is unique and focused on the individual needs of every client.\u003C/p\u003E\u003Ch2\u003EThe power of proactive maintenance\u003C/h2\u003E\u003Cp\u003ESupport from 3chillies is also fundamentally different from the support offered by most other digital agencies.\u003C/p\u003E\u003Cp\u003EOur approach of proactive maintenance enabled by comprehensive monitoring means every month we work to anticipate issues before they happen, minimising any disruption.  And we don\u2019t work to just prevent outages and issues, we also cover areas such as security and compliance.\u003C/p\u003E\u003Cp\u003EOur proactive maintenance approach has been so successful it means we can also spend more time responding to any issues raised. That\u2019s why we don\u2019t have an upper limit on the number of times you can contact us.\u003C/p\u003E\u003Cp\u003EOur support service also draws on the knowledge of the whole team. All our developers spend some time on support and when we need to, we will escalate an issue to one of our specialists. Whatever happens, we\u2019ve got your back!\u003C/p\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f1a20001-0001-0001-0001-000000000008",
      "key": "52e948a4-b0ed-43ef-b90e-ec8ce3aeb43a",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Frequently Asked Questions"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "f1a20001-0001-0001-0001-000000000009",
                "key": "1bdbc4e4-8dfe-4fe7-aac9-d6529231e6dd",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Do you offer 24 hour support?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EYes this is something we offer. Serving multinational brands we know this can be important to our customers.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f1a20001-0001-0001-0001-000000000009",
                "key": "8a1e51f3-6bdc-4478-a0b4-18299a9fb845",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Do you outsource your customer contact?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ENope, we keep all of this on site with our dedicated support team.\u003C/p\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "1bdbc4e4-8dfe-4fe7-aac9-d6529231e6dd",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "8a1e51f3-6bdc-4478-a0b4-18299a9fb845",
                "culture": null,
                "segment": null
              }
            ],
            "Layout": {
              "Umbraco.BlockList": [
                {
                  "contentKey": "1bdbc4e4-8dfe-4fe7-aac9-d6529231e6dd",

      ]
    },
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "111f2bee-481b-4ce9-9c04-dcba4cc2efeb",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2 data-pm-slice=\u00221 1 []\u0022\u003EWhy 3chillies for your website project?\u003C/h2\u003E\u003Cp\u003EWe\u2019ll partner with you to select the right CMS for your website project and your budget. We work with Umbraco, Sitecore, Optimizely and SharePoint / Microsoft 365 which provide a range of options.\u003C/p\u003E\u003Cp\u003EWe\u2019ll sort out the Content Management System (CMS), set up the optimal hosting and environment, and do the back-end development work.\u003C/p\u003E\u003Cp\u003EWe\u2019ll carry out the front-end work so that you have a beautiful and well-laid-out site with eye-catching pages.\u003C/p\u003E\u003Cp\u003EWe regularly partner with leading design and branding agencies as well as in-house teams. We\u2019re happy to work with your chosen agency.\u003C/p\u003E\u003Cp\u003EWe\u2019ll also add those important extras such as a custom integration or a cookie management solution.\u003C/p\u003E\u003Cp\u003EAnd finally, we can support your website. Our development work also comes with a warranty period to fix any issues that arise.\u003C/p\u003E\u003Cp\u003EWe always build and deploy using a proven agile methodology that follows industry best practices. We stick to agreed timetables and costs, but we don\u2019t cut corners.\u003C/p\u003E\u003Cp\u003EAnd it\u2019s all underpinned by the strong communication that characterises every 3chillies project.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

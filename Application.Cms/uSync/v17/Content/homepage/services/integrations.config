      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "a0707f98-58b6-4394-85ee-7abd7e933631",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EIntegrations that add value to your digital ecosystem\u003C/h2\u003E\u003Cp\u003EIntegrating applications with your core systems and business processes invariably adds value. Integrations help to drive efficiency, reduce duplication, support the integrity of data, minimise risk and deliver great customer or employee experiences.\u003C/p\u003E\u003Ch2\u003EIntegrations come in many different flavours.\u003C/h2\u003E\u003Cp\u003EA CMS and your CRM platform. A website with an ecommerce or booking solution. Integrating an ERM system with a case management system. An integration can make all the difference to streamlining a process, elevating an app or increasing your website stats.\u003C/p\u003E\u003Ch2\u003EWe\u0027ve worked on a vast number of systems integration projects.\u003C/h2\u003E\u003Cp\u003EIntegrations often feature within our projects. We\u0027ll work with you to investigate and analyse what you need and work out the best way to deliver the integration.\u003C/p\u003E\u003Cp\u003ESometimes there are out-of-the-box connectors that can deliver what you need or work as a starting point to then customise. Often we will use an API to deliver an integration. If that isn\u0027t in place we can build an API layer, which can also support future integrations too.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

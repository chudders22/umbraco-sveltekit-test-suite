      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "3157d55d-0228-465d-8fea-e087f4d5e4cd",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003ECustom business applications built for your needs.\u003C/h2\u003E\u003Cp\u003ENew ways to deliver services. Better engagement with customers and prospects. Simple ways to solve complex business problems. Whether you\u0027re looking for a customer-facing or internal business application or a web-based or mobile app, we can help.\u003C/p\u003E\u003Ch2\u003EOur track record\u003C/h2\u003E\u003Cp\u003EWe\u0027ve got a solid track record of helping our customers conceptualise, build and deploy custom applications. We\u0027ve produced apps that are embedded in web pages, deployed on public app stores and even launched within the enterprise.\u003C/p\u003E\u003Cp\u003EOnce launched, a business application is never done. We partner with our clients for ongoing iteration, improvement and support.\u003C/p\u003E\u003Ch2\u003EWhy we love creating bespoke business applications\u003C/h2\u003E\u003Cp\u003ENo two business applications are the same. They are unique to your requirements, technical specifications and budget. We approach every business application built with an open mind to its scope and base technology, but adhere to a rigid development process that ensures high security, quality and performance.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "9baa4165-027d-4834-8386-158f56553385",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EHosting that works for you\u003C/h2\u003E\u003Cp\u003EThe way you organise your environment to support your website and digital infrastructure is critical. At 3chillies we partner with you to manage, optimise and even host the environment in the way that works best for you.\u003C/p\u003E\u003Cp\u003ELooking for an agency to establish and manage your cloud-hosted environment? Want someone to partner with your IT function to advise and optimise your self-hosted infrastructure? Or need to set up an on-premises environment?\u003C/p\u003E\u003Ch2\u003EOur experience\u003C/h2\u003E\u003Cp\u003EWe\u0027ve been helping clients set up cloud-hosted sites for many years. As Microsoft Gold Partners, our preferred platform is Azure, but we also work with AWS.\u003C/p\u003E\u003Cp\u003EWe can do the heavy lifting on the set-up across your hosted environment. We can also advise on aspects such as setting up staging, UAT and development servers and introducing load balancing or a CDN.\u003C/p\u003E\u003Cp\u003EWe frequently advise on how to make your current hosted environment work harder for you. Practices such as analysing usage patterns and autoscaling can help streamline and right size your infrastructure, reducing your costs and your environmental impact.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

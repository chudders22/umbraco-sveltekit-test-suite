    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "44caf06e-c908-4d38-9390-5ebeb9947d99",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EYour digital partner for the public sector\u003C/h2\u003E\u003Cp\u003E3chillies has a long track record of working with UK public sector and government departments, delivering a variety of successful digital and cloud-based projects. Our range of clients includes some of the UK\u0027s highest profile public sector institutions.\u003C/p\u003E\u003Cp\u003EWe combine our extensive experience of working with the public sector and knowledge of its specific challenges, with technical expertise, commitment to value and a refreshingly straightforward working relationship.\u003C/p\u003E\u003Ch2\u003EWe are an approved Crown Commercial Service Supplier\u003C/h2\u003E\u003Cp\u003EWe\u0027re listed on both the G-Cloud 14 and Digital 6 Outcomes frameworks. We have been on these supplier listings for many years. We are always security-first and have the necessary accreditations including ISO 27001 and Cyber Essentials so our project approach and output meets the standards you need and expect.\u003C/p\u003E\u003Cp\u003EWe\u0027ve delivered a full range of services to public sector and governance organisations, from website development to custom app development to cloud migration and hosting (Azure). We\u0027ve also performed audit services and ongoing support.\u003C/p\u003E\u003Cp\u003EWhether you\u0027re looking to modernise legacy applications and move them to the cloud, or create a new compelling, integrated digital experience, we\u0027re here to help. Our work drives efficiencies, lowers costs, minimises risks, creates excellent experiences and even drives digital transformation.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

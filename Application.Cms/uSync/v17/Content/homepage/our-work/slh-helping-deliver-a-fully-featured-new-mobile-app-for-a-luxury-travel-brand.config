    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "d58ede3b-0278-407c-aa33-70db412e5423",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EThe challenge\u003C/h2\u003E\u003Cp\u003EThe mobile app for a luxury travel brand is a critical go-to-market channel, enabling guests to view properties and make reservations. However, the existing SLH mobile app was clearly out of date and only allowed users to view details of hotels with no reservation capability.\u003C/p\u003E\u003Cp\u003ETravellers downloading the app were disappointed, leading to poor app reviews. This was not only leading to missed opportunities for bookings but fundamentally undermined the SLH brand.\u003C/p\u003E\u003Ch2\u003EOur work\u003C/h2\u003E\u003Cp\u003EFollowing 3chillies\u0027 transformation of the SLH website into an elegant and smooth booking experience, we continued our successful partnership to deliver a beautiful new mobile app that would match the ambition and scope of SLH.com.\u003C/p\u003E\u003Cp\u003EWe had originally built APIs on the new website to enable integrations to support the new app. Bringing our technical expertise to the table, we were able to help provide a wide new set of features on the app.\u003C/p\u003E\u003Ch2\u003EThe results\u003C/h2\u003E\u003Cp\u003EExisting SLH customers can now make new bookings, view existing and upcoming reservations, and access discounted rates. We also enabled SLH to include an exciting new loyalty tier, SLH Club, where signed-up members can view benefits and a digital membership card.\u003C/p\u003E\u003Cp\u003EWe worked in partnership with SLH\u0027s app developers, Workmatrix, to help launch a gorgeous new look and feel that finally does justice to the beautiful SLH hotels around the world. The app is rounded off with an attractive interactive map feature and a new inspirational online magazine called Swoon by SLH.\u003C/p\u003E\u003Cp\u003EThe new SLH app was launched in November 2024 on the Apple Store and Google Play. Several of the five-star reviews note the improvement and contrast with the previous app.\u003C/p\u003E\u003Ch2\u003EThe future\u003C/h2\u003E\u003Cp\u003EWe\u0027re excited to see where the app goes and are working with SLH to keep on improving and supporting the app.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

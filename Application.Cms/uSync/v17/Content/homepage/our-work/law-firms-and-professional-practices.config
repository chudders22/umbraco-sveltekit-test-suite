      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "5b876115-06ab-4d66-86eb-9486ec063c8c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EYour digital partner for legal and professional services\u003C/h2\u003E\u003Cp\u003EYou might be looking for an attractive website that sets out your practice areas and validates your expertise and experience with knowledge-focused content. Perhaps you want to build a cutting-edge AI-powered extranet solution that supports better interaction with your clients. With a strong track record, particularly in the UK legal sector, we\u0027re here to help.\u003C/p\u003E\u003Cp\u003EWe work closely with your Marketing, IT and BD teams to develop, build, deploy and support websites and business applications that resonate with clients and opportunities. And we\u0027ll ensure your site meets the strictest criteria around security \u0026amp; compliance, data privacy and minimising your carbon footprint.\u003C/p\u003E\u003Cp\u003EWe also regularly partner with other experienced providers in the legal and professional services space including Living Group and Passle.\u003C/p\u003E\u003Ch2\u003ELaw firm and professional services sites have unique needs\u003C/h2\u003E\u003Cp\u003EThey must incorporate expert and technical content, spotlight partner and associate experience, and make content easily findable. At the same time, content publishing and admin needs to be as streamlined and effortless as possible both for busy support teams and occasionally even lawyers or consultants.\u003C/p\u003E\u003Cp\u003EWe work to tick all the boxes, partnering with you to deliver sophisticated experiences that drive lead generation while also helping your team work most effectively and efficiently.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

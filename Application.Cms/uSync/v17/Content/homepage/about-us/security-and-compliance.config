    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "2c328569-3d05-4302-90d4-f75c0897a53c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EAt 3chillies security and compliance is always top of mind and hard baked into everything we do and deliver.\u003C/h2\u003E\u003Cp\u003EThe protection of your people, your data, your network and infrastructure, and ultimately your reputation will always be our number one priority.\u003C/p\u003E\u003Cp\u003EWe work extensively with businesses and institutions in regulated and risk-averse sectors including government, legal and professional services, where security and compliance are critical.\u003C/p\u003E\u003Cp\u003EWe are proud of our \u003Cstrong\u003EISO 27001\u003C/strong\u003E and UK \u003Cstrong\u003ECyber Essentials\u003C/strong\u003E certification which are both independently and rigorously audited.\u003C/p\u003E\u003Cp\u003EWe also meet related standards such as the OWASP Application Security Verification Standard (ASVS). These credentials ensure that our processes around development, deployment and delivery are security-first and protect data privacy.\u003C/p\u003E\u003Cp\u003ECybersecurity is an ongoing challenge as the number of incidents continues to rise and new threats emerge. The regulatory environment particularly around data privacy also continues to be complex.\u003C/p\u003E\u003Cp\u003EAnd as we enter the age of AI, new cybersecurity and compliance considerations are appearing. It is essential to remain one step ahead.\u003C/p\u003E\u003Cp\u003EWe heavily invest in training our team and constantly staying updated for new threats, vulnerabilities and issues. We also deploy industry-leading tools to continuously monitor for threats and anomalies.\u003C/p\u003E\u003Cp\u003ECybersecurity, compliance and risk are non-negotiable. At 3chillies that continues to be reflected not only in the detail of our approach and daily work but in also in our mindset.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

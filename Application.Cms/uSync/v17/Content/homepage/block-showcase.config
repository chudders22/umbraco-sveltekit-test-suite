    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "c1000000-0000-4000-8000-000000000003",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EAt Acme Digital, we believe great technology should be invisible \u2014 empowering people to do more without getting in the way. Our team of designers, engineers, and strategists work together to create seamless digital products that put users first.\u003C/p\u003E\u003Cp\u003EWhether you need a complete digital transformation or a focused product sprint, we bring the expertise and passion to make it happen.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e9e5eac2-746d-4fb2-999e-1b08e229c836",
      "key": "c1000000-0000-4000-8000-000000000005",
      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ready to Start Your Project?"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003ELet\u0027s talk about how we can help you achieve your goals. Our team is ready to bring your vision to life with cutting-edge technology and thoughtful design.\u003C/p\u003E"
          }
        },
        {
          "alias": "actions",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }

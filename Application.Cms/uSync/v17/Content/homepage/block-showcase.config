    {
      "contentTypeKey": "f1a20001-0001-0001-0001-000000000008",
      "key": "c1000000-0000-4000-8000-000000000011",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Frequently Asked Questions"
        },
        {
          "alias": "subTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Everything you need to know"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "f1a20001-0001-0001-0001-000000000009",
                "key": "d6000000-0000-4000-8000-000000000001",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "How long does a typical project take?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EProject timelines vary based on scope and complexity. A focused MVP typically takes 8\u201312 weeks, while larger engagements may run 4\u20136 months. We\u2019ll provide a detailed timeline during our discovery phase.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f1a20001-0001-0001-0001-000000000009",
                "key": "d6000000-0000-4000-8000-000000000002",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "What technologies do you specialise in?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWe work across a broad technology stack, with deep expertise in .NET, React, SvelteKit, and headless CMS platforms like Umbraco. We always recommend the right technology for your specific needs.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f1a20001-0001-0001-0001-000000000009",
                "key": "d6000000-0000-4000-8000-000000000003",
                "values": [
                  {
                    "alias": "question",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Do you offer post-launch support?"
                  },
                  {
                    "alias": "answer",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EYes \u2014 all our projects include a 30-day post-launch support period as standard. We also offer flexible ongoing maintenance and support packages tailored to your needs.\u003C/p\u003E"

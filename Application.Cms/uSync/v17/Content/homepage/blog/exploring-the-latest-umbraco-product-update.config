<Content Key="a0aaf894-0f38-4162-a798-99d0ea025a9d" Alias="Exploring the latest Umbraco product update" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

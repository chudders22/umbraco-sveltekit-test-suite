<?xml version="1.0" encoding="utf-8"?>
<Content Key="7e431f65-b2d6-4614-866a-59ea3c5bff25" Alias="Unpacking the latest Sitecore product announcement: six key elements" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/unpacking-the-latest-sitecore-product-announcement-six-key-elements</Path>
    <Trashed>false</Trashed>

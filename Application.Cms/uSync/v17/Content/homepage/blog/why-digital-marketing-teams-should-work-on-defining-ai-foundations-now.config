<Content Key="e8cfdd75-b65d-46dc-a6c6-e86b0dd20166" Alias="Why digital marketing teams should work on defining AI foundations now" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/why-digital-marketing-teams-should-work-on-defining-ai-foundations-now</Path>
    <Trashed>false</Trashed>

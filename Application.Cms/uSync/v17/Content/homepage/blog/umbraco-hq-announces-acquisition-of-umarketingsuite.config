<?xml version="1.0" encoding="utf-8"?>
<Content Key="1e9ae5d2-c3cf-4c96-9095-6a63f7ac218e" Alias="Umbraco HQ announces acquisition of uMarketingSuite" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

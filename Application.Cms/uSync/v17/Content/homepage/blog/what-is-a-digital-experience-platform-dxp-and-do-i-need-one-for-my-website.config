<Content Key="77c940ef-e1dc-400c-b65f-782fc4c53ee6" Alias="What is a Digital Experience Platform (DXP) and do I need one for my website?" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/what-is-a-digital-experience-platform-dxp-and-do-i-need-one-for-my-website</Path>

<Content Key="d07ed8ab-377f-41a4-8b43-cbf1492293de" Alias="what-to-expect-when-upgrading-your-content-management-system" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/what-to-expect-when-upgrading-your-content-management-system</Path>

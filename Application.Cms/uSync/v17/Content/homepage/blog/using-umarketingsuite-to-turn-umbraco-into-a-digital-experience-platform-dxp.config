<?xml version="1.0" encoding="utf-8"?>
<Content Key="55ca6104-f6ad-46ed-a426-7a8dbff3318b" Alias="Using uMarketingSuite to turn Umbraco into a Digital Experience Platform (DXP)" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/using-umarketingsuite-to-turn-umbraco-into-a-digital-experience-platform-dxp</Path>
    <Trashed>false</Trashed>

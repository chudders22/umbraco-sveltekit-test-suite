<Content Key="cad42306-4a78-4b6c-83fd-4551ac9bbb46" Alias="Sitecore XM Cloud" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="4be2fab0-cf02-4936-891e-caf342e14fb1" Alias="Going global: nine elements to consider when evolving your website to a global presence" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/going-global-nine-elements-to-consider-when-evolving-your-website-to-a-global-presence</Path>

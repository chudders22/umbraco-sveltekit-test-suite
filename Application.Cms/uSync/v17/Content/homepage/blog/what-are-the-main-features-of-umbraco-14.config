<?xml version="1.0" encoding="utf-8"?>
<Content Key="27b4ad50-1a2a-4798-897d-20f0f33c4dc3" Alias="What are the main features of Umbraco 14?" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/what-are-the-main-features-of-umbraco-14</Path>
    <Trashed>false</Trashed>
    <ContentType>blogArticle</ContentType>

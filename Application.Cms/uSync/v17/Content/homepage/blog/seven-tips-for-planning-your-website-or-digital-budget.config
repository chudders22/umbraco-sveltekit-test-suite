<?xml version="1.0" encoding="utf-8"?>
<Content Key="d28fdfb4-3053-45b6-9e48-f17dd8c6a9ae" Alias="Seven tips for planning your website or digital budget" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/seven-tips-for-planning-your-website-or-digital-budget</Path>

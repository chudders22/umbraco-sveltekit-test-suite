<?xml version="1.0" encoding="utf-8"?>
<Content Key="9c5aa9f4-210c-4da4-bd75-dc8ea1c89327" Alias="Umbraco Update: Product and strategy highlights from the Winter Keynote" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

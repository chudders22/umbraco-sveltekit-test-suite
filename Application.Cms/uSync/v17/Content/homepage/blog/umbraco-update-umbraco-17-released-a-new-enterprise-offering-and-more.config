<?xml version="1.0" encoding="utf-8"?>
<Content Key="0513d6e9-8025-4f41-ad07-5888f9222bbc" Alias="Umbraco update: Umbraco 17 released, a new enterprise offering and more" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/umbraco-update-umbraco-17-released-a-new-enterprise-offering-and-more</Path>
    <Trashed>false</Trashed>
    <ContentType>blogArticle</ContentType>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="6f901335-6891-435e-b3ff-5d75320d88dc" Alias="Why good communication is at the heart of a successful digital project" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/why-good-communication-is-at-the-heart-of-a-successful-digital-project</Path>
    <Trashed>false</Trashed>

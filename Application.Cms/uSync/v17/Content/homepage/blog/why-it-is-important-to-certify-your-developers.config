<?xml version="1.0" encoding="utf-8"?>
<Content Key="1b7d4a50-872e-4610-8906-95bdfa96ea8f" Alias="Why it is important to certify your developers" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/why-it-is-important-to-certify-your-developers</Path>
    <Trashed>false</Trashed>

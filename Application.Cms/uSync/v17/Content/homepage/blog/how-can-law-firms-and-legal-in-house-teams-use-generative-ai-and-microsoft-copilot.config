<?xml version="1.0" encoding="utf-8"?>
<Content Key="bd311449-3fe8-4d92-877c-f8946297bd99" Alias="How can law firms and legal in-house teams use generative AI and Microsoft Copilot?" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/how-can-law-firms-and-legal-in-house-teams-use-generative-ai-and-microsoft-copilot</Path>

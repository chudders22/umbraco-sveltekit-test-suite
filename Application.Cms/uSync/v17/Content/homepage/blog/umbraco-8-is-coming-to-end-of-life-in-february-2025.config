<?xml version="1.0" encoding="utf-8"?>
<Content Key="3d36bcf5-877a-46cb-8045-1c207fe4d8ae" Alias="Act now: Umbraco 8 is coming to end of life in February 2025 – your FAQs, options and more." Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/umbraco-8-is-coming-to-end-of-life-in-february-2025</Path>
    <Trashed>false</Trashed>
    <ContentType>blogArticle</ContentType>
    <CreateDate>2025-02-25T00:00:00</CreateDate>
    <NodeName Default="Act now: Umbraco 8 is coming to end of life in February 2025 – your FAQs, options and more." />
    <SortOrder>42</SortOrder>

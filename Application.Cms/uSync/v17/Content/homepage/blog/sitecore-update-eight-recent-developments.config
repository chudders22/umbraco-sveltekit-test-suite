<Content Key="fe9eaede-ff9c-4b92-95c5-93210c62e40b" Alias="Sitecore Update: Eight Recent Developments" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

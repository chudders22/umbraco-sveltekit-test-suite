<Content Key="a3ab7661-2b51-4eac-9b91-fba2bd2e9865" Alias="Ten ways to fall back in love with your CMS" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/ten-ways-to-fall-back-in-love-with-your-cms</Path>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="81bad89d-d2d9-4edf-b78e-be4fac66fe12" Alias="Managing images and assets on your website" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/managing-images-and-assets-on-your-website</Path>
    <Trashed>false</Trashed>
    <ContentType>blogArticle</ContentType>

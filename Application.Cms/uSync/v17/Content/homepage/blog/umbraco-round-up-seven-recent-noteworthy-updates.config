<?xml version="1.0" encoding="utf-8"?>
<Content Key="45c9aca1-5e7d-40bd-ba33-3c62330d4b89" Alias="Umbraco round-up seven recent noteworthy updates" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>

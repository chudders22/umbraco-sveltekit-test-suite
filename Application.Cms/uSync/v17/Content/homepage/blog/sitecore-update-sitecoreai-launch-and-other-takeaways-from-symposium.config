<?xml version="1.0" encoding="utf-8"?>
<Content Key="3efe5bd1-6ca4-4f2c-a1ca-1abb20c1d91e" Alias="Sitecore update: SitecoreAI launch and other takeaways from Symposium" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/sitecore-update-sitecoreai-launch-and-other-takeaways-from-symposium</Path>
    <Trashed>false</Trashed>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="8f101f85-2d0a-440c-b8ae-d2c4d74d3658" Alias="Unpacking Sitecore’s latest product update event: key takeaways" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/unpacking-sitecore-s-latest-product-update-event-key-takeaways</Path>
    <Trashed>false</Trashed>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="56f5b83f-b8d9-49c3-bc2b-a60405682a13" Alias="Umbraco update: From the release of Umbraco 15 to the launch of Umbraco Engage" Level="3">
  <Info>
    <Parent Key="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">Blog</Parent>
    <Path>/Homepage/Blog/umbraco-update-from-the-release-of-umbraco-15-to-the-launch-of-umbraco-engage</Path>
    <Trashed>false</Trashed>

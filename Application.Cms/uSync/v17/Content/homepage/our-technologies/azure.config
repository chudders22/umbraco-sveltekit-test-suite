    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "971e2e69-1cf2-4c51-96f1-63a5973a63ac",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EAs long-term Microsoft Gold partners, we\u0027re big advocates of Azure.\u003C/h2\u003E\u003Cp\u003EAzure is one of the two major cloud hosting platforms along with Amazon Web Services (AWS). It tends to be our hosting platform of choice for a wide range of websites and digital projects.\u003C/p\u003E\u003Ch2\u003EGetting the best out of Azure\u003C/h2\u003E\u003Cp\u003EWe\u0027ve been using Azure for hosting since it was first introduced in 2010. Over the years we\u0027ve completed hundreds of projects that rely on Azure, and in that time, we\u0027ve developed deep technical knowledge.\u003C/p\u003E\u003Ch2\u003EWhy we love working with Azure\u003C/h2\u003E\u003Cp\u003EAzure provides an extremely reliable and highly scalable hosting platform that is suitable for almost every cloud-based digital project, ensuring exceptional performance, supporting effective DevOps and proofing you for future change.\u003C/p\u003E\u003Cp\u003EAzure also opens up access to a number of different services that allows you to do everything from integrating all your unstructured data to enabling the very latest AI services.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

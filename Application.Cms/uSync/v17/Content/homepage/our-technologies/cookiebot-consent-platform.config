      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "4f9a37f7-93d0-4de1-91a3-7f1dab1887bf",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EWhat is Usercentrics Cookiebot?\u003C/h2\u003E\u003Cp\u003ECookie management is essential for any website. Compliance is king and customers expect data privacy as a given. GDPR and other related legislation means that you are required to gain consent for the use of cookies from your website visitors.\u003C/p\u003E\u003Cp\u003EMany teams find it difficult to keep up with the ever-evolving cookie landscape. The best way to manage cookies is to use a leading cookie management solution like Usercentrics Cookiebot that seamlessly integrates with your website.\u003C/p\u003E\u003Ch2\u003EA leading cookie management and consent solution\u003C/h2\u003E\u003Cp\u003E3chillies has been helping clients implement Usercentrics Cookiebot for several years. It\u0027s one of the world\u0027s most trusted cookie management and consent solutions, used on over 2 million websites and managing over 7 billion user consents per month.\u003C/p\u003E\u003Ch2\u003EWhy we love working with Usercentrics Cookiebot\u003C/h2\u003E\u003Cp\u003EUsercentrics Cookiebot allows you to automate privacy compliance and minimise the effort around visitor consent. One of our favourite features is the monthly automatic scanning which identifies any cookies and tracking technologies used by your site.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

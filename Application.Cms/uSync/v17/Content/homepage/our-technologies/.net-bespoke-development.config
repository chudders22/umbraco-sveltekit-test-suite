      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "fb6758ab-f6bc-4ed7-82c7-9f7d87fce5cb",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EBespoke .NET development tailored to your needs.\u003C/h2\u003E\u003Cp\u003EOur team of .NET developers are on hand to create high-quality and inspired bespoke apps, integrations and solutions. All are designed to fit exactly around your needs and processes.\u003C/p\u003E\u003Cp\u003EOver the past two decades, we\u0027ve delivered multiple custom .NET projects, seeing them through from the initial spark of an idea through to deployment and support.\u003C/p\u003E\u003Ch2\u003EWhat is .NET?\u003C/h2\u003E\u003Cp\u003E.NET is a popular and long-standing open-source software development framework which is mainly updated through Microsoft. It is not only the foundation for many commercial business software solutions but is also the ideal base for bespoke development.\u003C/p\u003E\u003Ch2\u003EWe are a Microsoft Gold Partner\u003C/h2\u003E\u003Cp\u003E3chillies has been a Microsoft Gold Partner for many years. Our in-house development team have deep .NET experience and expertise.\u003C/p\u003E\u003Cp\u003EWe always follow a disciplined agile software development approach backed by a robust, reliable and proven delivery approach to ensure solutions are on time and on-budget.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

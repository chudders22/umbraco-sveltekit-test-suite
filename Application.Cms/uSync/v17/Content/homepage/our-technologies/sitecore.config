    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "555e3cb0-cec8-4a8f-8ec3-580217d1888c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003ESitecore is one of the world\u0027s leading digital experience platforms.\u003C/h2\u003E\u003Cp\u003ELeading organisations and enterprises chose to rely on Sitecore\u0027s extensive set of content management capabilities, optimisation features and digital marketing tools to deliver world-class websites.\u003C/p\u003E\u003Ch2\u003ESitecore Gold Partners\u003C/h2\u003E\u003Cp\u003E3chillies is a Sitecore Gold Partner. We\u0027re one of the UK\u0027s most experienced Sitecore agencies, having been first recognised as a Sitecore Partner in 2007. We currently have twelve Sitecore developers.\u003C/p\u003E\u003Cp\u003EOver nearly two decades of working with the platform, we\u0027ve successfully delivered a huge number of Sitecore websites for professional services firms, public sector organisations, large companies and more.\u003C/p\u003E\u003Ch2\u003EWhy we love working with Sitecore\u003C/h2\u003E\u003Cp\u003ESitecore\u0027s power and flexibility makes it one of the most exciting platforms to work with. It is particularly strong in delivering personalisation and marketing automation through its industry-leading features.\u003C/p\u003E\u003Cp\u003EOne of the Sitecore\u0027s strengths has always been its wide range of tools that can be accessed in one, focused and integrated platform.\u003C/p\u003E\u003Cp\u003EIn recent years Sitecore has also made many of its core tools available separately on a SaaS-basis, while also building more connectors to other tools.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

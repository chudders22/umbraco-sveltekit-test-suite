      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "925ba963-d39c-4206-b9ff-626164a11f14",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2\u003EUmbraco is a highly versatile and cost-effective, open-source content management system.\u003C/h2\u003E\u003Cp\u003EUmbraco can be used to build great websites and other digital experiences. It\u0027s popular with marketing teams and IT functions alike because of its ease of use and support for flexible development.\u003C/p\u003E\u003Ch2\u003EUmbraco Platinum Partners\u003C/h2\u003E\u003Cp\u003EWe\u0027re proud to have been working with the platform for more than a decade, producing multiple Umbraco websites ranging from the simple to the complex. We have been certified Umbraco Certified Partners since 2015 and currently have ten Umbraco developers.\u003C/p\u003E\u003Ch2\u003EWhy we love working with Umbraco\u003C/h2\u003E\u003Cp\u003EOne of the reasons we love working with the platform is its sheer flexibility in being able to produce excellent results. Our clients love Umbraco too \u2014 the content management and editing experience has a deserved reputation as being intuitive and easy to use.\u003C/p\u003E\u003Cp\u003EBecause Umbraco is open source it has no licensing fees, coming in at a significantly lower price point than some other platforms, but offering the same depth of features.\u003C/p\u003E"
          }
        }
      ]
    }
  ],

<?xml version="1.0" encoding="utf-8"?>
<Content Key="77bba046-300a-4a80-a35a-d27ace0bfb5e" Alias="Nine components of a successful digital agency support model (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/NineComponentsOfASuccessfulDigitalAgencySupportModel1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

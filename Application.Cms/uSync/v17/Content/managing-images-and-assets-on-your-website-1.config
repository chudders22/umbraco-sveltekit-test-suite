<?xml version="1.0" encoding="utf-8"?>
<Content Key="6ba85154-e098-4a21-94fe-b55b25021a51" Alias="Managing images and assets on your website (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/ManagingImagesAndAssetsOnYourWebsite1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="83cfc50d-86a5-49de-8a11-44e6b3fa8be0" Alias="Why it pays to plan for iterative development on your website (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/WhyItPaysToPlanForIterativeDevelopmentOnYourWebsite1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

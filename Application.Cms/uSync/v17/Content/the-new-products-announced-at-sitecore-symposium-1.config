<?xml version="1.0" encoding="utf-8"?>
<Content Key="3597532b-04e0-4af2-90b6-450471b71ec8" Alias="The new products announced at Sitecore Symposium (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/TheNewProductsAnnouncedAtSitecoreSymposium1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

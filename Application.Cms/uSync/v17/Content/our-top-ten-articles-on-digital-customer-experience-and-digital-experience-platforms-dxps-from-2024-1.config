  <Properties>
    <metaDescription>
      <Value><![CDATA[In this post we look back at ten of our most popular articles that you may have missed during the year.]]></Value>
    </metaDescription>
    <metaTitle>
      <Value><![CDATA[Our top ten articles on digital customer experience and digital experience platforms (DXPs) from 2024]]></Value>
    </metaTitle>

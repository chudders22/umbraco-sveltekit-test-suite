=800\u0026amp;height=600\u0026amp;v=1dc077d6186c180\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/nh5ngawj/wildflowers-7688547_1920.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077d6186c180\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/nh5ngawj/wildflowers-7688547_1920.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc077d6186c180\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EUmbraco update: Umbraco 17 now in beta\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EUmbraco 17 is now in beta. In this brief post we explore what is in the new release as well as its expected rollout timetable.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E20 Oct 2025\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Umbraco\u0022\u003EUmbraco\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco-update-2026-pricing-new-uk-office-and-more/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opa
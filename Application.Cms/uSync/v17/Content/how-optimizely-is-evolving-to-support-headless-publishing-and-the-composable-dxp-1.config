<?xml version="1.0" encoding="utf-8"?>
<Content Key="7f41633d-c7ef-446f-a267-9770db3465c9" Alias="How Optimizely is evolving to support headless publishing and the composable DXP (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/HowOptimizelyIsEvolvingToSupportHeadlessPublishingAndTheComposableDXP1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

<?xml version="1.0" encoding="utf-8"?>
<Content Key="21182acb-2932-433f-b784-dff43e8037c8" Alias="Our new office and way of working (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/OurNewOfficeAndWayOfWorking1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

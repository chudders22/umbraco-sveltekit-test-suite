<?xml version="1.0" encoding="utf-8"?>
<Content Key="7e1ffac5-44f8-4318-a2dc-823803a89108" Alias="Why it is important to certify your developers (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/WhyItIsImportantToCertifyYourDevelopers1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

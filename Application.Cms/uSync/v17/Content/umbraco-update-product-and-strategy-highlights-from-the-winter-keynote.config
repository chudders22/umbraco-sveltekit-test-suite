<?xml version="1.0" encoding="utf-8"?>
<Content Key="d73f328a-77e8-466d-a113-1f3c3ccad2a1" Alias="Umbraco Update: Product and strategy highlights from the Winter Keynote" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/UmbracoUpdateProductAndStrategyHighlightsFromTheWinterKeynote</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

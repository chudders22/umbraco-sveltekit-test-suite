\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/why-it-is-important-to-certify-your-developers/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opacity-40\u0022\u003E\n\u003Cpicture\u003E\n\u003Csource data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/s3ooj5en/night.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc077392f167c0\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/s3ooj5en/night.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077392f167c0\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Image of the Northern lights - coloured lights against a night sky\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/s3ooj5en/night.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc077392f167c0\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/s3ooj5en/night.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077392f167c0\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/s3ooj5en/night.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc077392f167c0\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EWhy it is important to certify your developers\u003C/p\u003E
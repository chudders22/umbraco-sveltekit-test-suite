-\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E08 Sep 2025\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/accessibility/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Accessibility\u0022\u003EAccessibility\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/content-management/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Content Management\u0022\u003EContent Management\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/sitecore/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Sitecore\u0022\u003ESitecore\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Umbraco\u0022\u003EUmbraco\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/five-tips-to-make-digital-progress-when-you-have-limited-resources/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opacity-40\u0022\u003E\n\u003Cpicture\u003E\n\u003Csource data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/l00lpdtp/board-453758_1280.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/l00lpdtp/board-453758_1280.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;qual
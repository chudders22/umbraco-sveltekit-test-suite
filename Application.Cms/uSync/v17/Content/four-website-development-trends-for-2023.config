height=600\u0026amp;v=1dc077ba0814330\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/dxqjndcw/nasa-_sfjhrpzjhs-unsplash.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077ba0814330\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Image showing Manhattan island lit up at at night, taken by a satellite \u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/dxqjndcw/nasa-_sfjhrpzjhs-unsplash.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc077ba0814330\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/dxqjndcw/nasa-_sfjhrpzjhs-unsplash.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077ba0814330\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/dxqjndcw/nasa-_sfjhrpzjhs-unsplash.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc077ba0814330\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EEight ways to improve the environmental impact of your website\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EThe good news is there are quite a few straightforward things that can be done to reduce carbon emissions and most of these also improve usability and can even cut your costs. In this post, we explore eight ways to improve the environmental impact of your website.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E24 Jun 2024\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/environmental-impact/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Environmental Impact\u0022\u003EEnvironmental Impact\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/azure/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Azure\u0022\u003EAzure\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/four-website-development-trends-for-2023/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opacity-40\u0022\u003E\n\u003Cpicture\u003E\n\u003Csource data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ilhtp03/blur-1853262_1280.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc0777b2476bc0\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ilhtp03/blur-1853262_1280.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc0777b2476bc0\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Abstract image of a graph on a computer screen\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ilhtp03/blur-1853262_1280.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc0777b2476bc0\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ilhtp03/blur-1853262_1280.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc0777b2476bc0\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ilhtp03/blur-1853262_1280.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc0777b2476bc0\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EFour website development trends for 2023\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EMaking trend predictions for the coming year always comes with the inherent risk of looking a bit silly when you get to December, just in case you got everything wrong! But I find it\u2019s also a useful exercise in thinking about the wider environment and reflecting on your own plans for the year.\u00A0\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E13 Jan 2023\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/development/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Development\u0022\u003EDevelopment\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/environmental-impact/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Environmental Impact\u0022\u003EEnvironmental Impact\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/security/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Security\u0022\u003ESecurity\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/ai/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022AI\u0022
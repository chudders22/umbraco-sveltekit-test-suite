<?xml version="1.0" encoding="utf-8"?>
<Content Key="9f9820de-099f-4968-8a9b-2e3ccb66bf9c" Alias="Unpacking Sitecore’s latest product update event: key takeaways (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/UnpackingSitecoreSLatestProductUpdateEventKeyTakeaways1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

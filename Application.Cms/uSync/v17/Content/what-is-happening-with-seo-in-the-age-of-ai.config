t=1200\u0026amp;v=1dc0775be17c870\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Close up image of an old fashioned light bulb\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ijhtjyl/light-bulb-4514505_1280.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc0775be17c870\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ijhtjyl/light-bulb-4514505_1280.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc0775be17c870\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/5ijhtjyl/light-bulb-4514505_1280.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc0775be17c870\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EGetting started with Generative Engine Optimisation (GEO) and Answer Engine Optimisation (AEO): 7 tips\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EGenerative AI is changing the way we search and interact with information. More and more people are using ChatGPT, Claude and other AI services to try and find information they need.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E30 Sep 2025\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/seo/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022SEO\u0022\u003ESEO\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\
<?xml version="1.0" encoding="utf-8"?>
<Content Key="24c55040-8321-4e18-ada5-71b6a1c58a2c" Alias="How 3Chillies is supporting the public sector: G-Cloud 13 and Digital Outcomes 6 (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/How3ChilliesIsSupportingThePublicSectorGCloud13AndDigitalOutcomes61</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>
    <ContentType>blogArticle</ContentType>
    <CreateDate>2024-11-06T00:00:00</CreateDate>
    <NodeName Default="How 3Chillies is supporting the public sector: G-Cloud 13 and Digital Outcomes 6 (1)" />

<?xml version="1.0" encoding="utf-8"?>
<Content Key="ada94a04-13e1-43e5-afee-e7594db730be" Alias="How can law firms and legal in-house teams use generative AI and Microsoft Copilot? (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/HowCanLawFirmsAndLegalInHouseTeamsUseGenerativeAIAndMicrosoftCopilot1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

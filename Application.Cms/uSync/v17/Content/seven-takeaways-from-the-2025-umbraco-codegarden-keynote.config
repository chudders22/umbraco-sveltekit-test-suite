a/3zpfignx/keyboard-70506_1280.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc0776523ce490\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003ETen more tactics to support a more accessible and inclusive website\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EAchieving a more accessible and inclusive website is not always straightforward. In this post we\u2019re going to explore ten tactics to help achieve it.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E08 Sep 2025\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/accessibility/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Accessibility\u0022\u003EAccessibility\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/content-management/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Content Management\u0022\u003EContent Management\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/sitecore/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Sitecore\u0022\u003ESitecore\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Umbraco\u0022\u003EUmbraco\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-3 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\
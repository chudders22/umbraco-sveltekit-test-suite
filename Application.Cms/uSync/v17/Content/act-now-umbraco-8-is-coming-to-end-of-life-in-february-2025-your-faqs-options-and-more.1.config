<?xml version="1.0" encoding="utf-8"?>
<Content Key="2d7681d7-da6b-45c9-b406-a1b1995881cf" Alias="Act now: Umbraco 8 is coming to end of life in February 2025 – your FAQs, options and more. (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/ActNowUmbraco8IsComingToEndOfLifeInFebruary2025YourFAQsOptionsAndMore1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>
    <ContentType>blogArticle</ContentType>
    <CreateDate>2025-02-25T00:00:00</CreateDate>
    <NodeName Default="Act now: Umbraco 8 is coming to end of life in February 2025 – your FAQs, options and more. (1)" />

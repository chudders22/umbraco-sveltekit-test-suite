<?xml version="1.0" encoding="utf-8"?>
<Content Key="9d8f8012-264b-49ec-9acb-c9a10939285b" Alias="Why the time is right to introduce personalisation (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/WhyTheTimeIsRightToIntroducePersonalisation1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

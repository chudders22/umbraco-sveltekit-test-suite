<?xml version="1.0" encoding="utf-8"?>
<Content Key="8b1c5325-d101-48cd-a53b-5f22a68902af" Alias="Unpacking the latest Sitecore product announcement: six key elements (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/UnpackingTheLatestSitecoreProductAnnouncementSixKeyElements1</Path>
    <Trashed Parent="68beea09-9849-49dd-ac5d-7e5c9b5c9e84">true</Trashed>

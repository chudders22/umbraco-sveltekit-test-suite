    <pageContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a58b29f0-29c6-47b8-b8ce-329b38fbed3c",
      "key": "377aa40c-7da8-4b65-9a14-b403889ee415",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cdiv class=\u0022component-inner\u0022\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cdiv class=\u0022text base-text\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022\u003E\n\u003Cp\u003ELast week we had a great 3chillies company away day in London.\u003C/p\u003E\n\u003Cp\u003EMany of us work remotely now with some staff living as far afield as Leeds, Torbay, South Wales and Bristol. The away day was a welcome opportunity to get together in person as a team, catch up with each other, and even meet some colleagues face to face for the first time.\u003C/p\u003E\n\u003Cp\u003EWe spent the morning taking stock of how the year has gone so far and what we have planned going into 2025. It\u0027s been a good year for 3chillies with us winning new work and delivering some major projects, and we\u0027re looking forward to this continuing.\u003C/p\u003E\n\u003Cp\u003EWith the working part of the day out of the way, the afternoon was spent at The Crystal Maze Live Experience in central London. This is based on the legendary nineties TV show where players take on various physical and mental challenges.\u003C/p\u003E\n\u003Cp\u003EWe split into smaller teams and enjoyed a bit of healthy competition. Some of us turned out to be unexpectedly competitive!\u003C/p\u003E\n\u003Cp\u003EThe whole day was brilliant . It was a much enjoyed break from our usual routine that was an excellent boost to company morale and a chance to bond with colleagues in person.\u003C/p\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/div\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [
    {
      "contentTypeKey": "47b7548d-92f8-4a3d-a632-0b495b62b3ff",

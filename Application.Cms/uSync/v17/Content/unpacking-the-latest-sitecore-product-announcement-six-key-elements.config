\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EOur top ten articles on digital customer experience and digital experience platforms (DXPs) from 2024\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EIn this post we look back at ten of our most popular articles that you may have missed during the year.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E05 Dec 2024\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Umbraco\u0022\u003EUmbraco\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/sitecore/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Sitecore\u0022\u003ESitecore\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/environmental-impact/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Environmental Impact\u0022\u003EEnvironmental Impact\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/optimizely/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Optimizely\u0022\u003EOptimizely\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/content-management/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Content Management\u0022\u003EContent Management\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/upgrades/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Upgrades\u0022\u003EUpgrades\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E
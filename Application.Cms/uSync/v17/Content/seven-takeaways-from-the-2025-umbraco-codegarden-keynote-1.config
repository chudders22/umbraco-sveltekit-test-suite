<Content Key="1984d9ac-dd2c-496d-8857-16a329dca34b" Alias="Seven takeaways from the 2025 Umbraco Codegarden keynote (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>
    <Path>/[-20]/SevenTakeawaysFromThe2025UmbracoCodegardenKeynote1</Path>

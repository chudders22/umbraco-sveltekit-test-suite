<?xml version="1.0" encoding="utf-8"?>
<Content Key="adaa4c18-315f-47b0-89b1-2b209ecf3d64" Alias="Sitecore Update: Eight Recent Developments (1)" Level="101">
  <Info>
    <Parent Key="00000000-0000-0000-0000-000000000000"></Parent>

2 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Environmental Impact\u0022\u003EEnvironmental Impact\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/security/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Security\u0022\u003ESecurity\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/azure/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Azure\u0022\u003EAzure\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/seo/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022SEO\u0022\u003ESEO\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/sitecore-update-sitecoreai-launch-and-other-takeaways-from-symposium/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opacity-40\u0022\u003E\n\u003Cpicture\u003E\n\u003Csource data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/udjjggy0/sitecoreai.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc646f4ffa6670\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/udjjggy0/sitecoreai.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc646f4ffa6670\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/udjjggy0/sitecoreai.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc646f4ffa6670\u0026amp;for
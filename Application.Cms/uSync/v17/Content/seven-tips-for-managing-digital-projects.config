=1200\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Close up image of a green electrical circuit board\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/l00lpdtp/board-453758_1280.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/l00lpdtp/board-453758_1280.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/l00lpdtp/board-453758_1280.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc0778c459ed50\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EOur top ten articles on digital customer experience from 2022\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EThis year we have published over 20 articles on our blog covering topics relating to websites, content management and digital customer experience - here we\u2019re going to explore some of our most popular articles from the last twelve months.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E16 Dec 2022\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/ai/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022AI\u0022\u003EAI\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/sitecore/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Sitecore\u0022\u003ESitecore\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/umbraco/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Umbraco\u0022\u003EUmbraco\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/seo/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022SEO\u0022\u003ESEO\u003C/a\u003E\n\u003C/li\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/project-management/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Project Management\u0022\u003EProject Management\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022item item-blog items-4 col-12 item_text-below text-left\u0022 data-os-animation=\u0022fadeIn\u0022 data-os-animation-delay=\u00220s\u0022 data-os-animation-duration=\u00221.2s\u0022\u003E\n\u003Cdiv class=\u0022inner\u0022\u003E\n\u003Ca href=\u0022/3chillies-blog/why-good-communication-is-at-the-heart-of-a-successful-digital-project/\u0022\u003E\n\u003Cdiv class=\u0022image image-opacity-100 image_hover-opacity-40\u0022\u003E\n\u003Cpicture\u003E\n\u003Csource data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/aithaxu4/rene-bohmer-yeuvdkzwsz4-unsplash.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc077b1bb94210\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/aithaxu4/rene-bohmer-yeuvdkzwsz4-unsplash.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077b1bb94210\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 type=\u0022image/webp\u0022 width=\u0022800\u0022/\u003E\n\u003Cimg alt=\u0022Abstract image showing a shower of warm lights against a dark background\u0022 class=\u0022lazyload\u0022 data-srcset=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/aithaxu4/rene-bohmer-yeuvdkzwsz4-unsplash.jpg?width=800\u0026amp;height=600\u0026amp;v=1dc077b1bb94210\u0026amp;format=webp\u0026amp;quality=75 1x, https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/aithaxu4/rene-bohmer-yeuvdkzwsz4-unsplash.jpg?width=1600\u0026amp;height=1200\u0026amp;v=1dc077b1bb94210\u0026amp;format=webp\u0026amp;quality=75 2x\u0022 height=\u0022600\u0022 src=\u0022https://eurn-cdn-endpoint-10-10-d2agf5gpbxa5gkge.z02.azurefd.net/34be0bae2605/media/aithaxu4/rene-bohmer-yeuvdkzwsz4-unsplash.jpg?width=160\u0026amp;height=120\u0026amp;v=1dc077b1bb94210\u0026amp;format=webp\u0026amp;quality=75\u0022 width=\u0022800\u0022/\u003E\n\u003C/picture\u003E\n\u003C/div\u003E\n\u003Cdiv class=\u0022info\u0022\u003E\n\u003Cp class=\u0022heading md base-heading\u0022\u003EWhy good communication is at the heart of a successful digital project\u003C/p\u003E\n\u003Cdiv class=\u0022text base-text\u0022\u003E\u003Cp\u003EIn this article Paul explores some of the communication tactics that we\u0027ve seen work and how we try and ensure there is good communication across the projects that we deliver to our clients.\u003C/p\u003E\u003C/div\u003E\n\u003C/div\u003E\n\u003C/a\u003E\n\u003C!-- Meta --\u003E\n\u003Cdiv class=\u0022meta base-text\u0022\u003E\n\u003Cp class=\u0022date\u0022\u003E\u003Ctime\u003E24 Nov 2022\u003C/time\u003E\u003C/p\u003E\n\u003Cdiv class=\u0022categories base-text\u0022\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Ca href=\u0022/3chillies-blog/project-management/\u0022 rel=\u0022NOINDEX, FOLLOW\u0022 title=\u0022Project Management\u0022\u003EProject Management\u003C/a\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C!--// Meta --\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/div\u003E\n\u003C/section\u003E\n\u003C!-- Meta --\u003E\n\u0